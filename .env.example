ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=change-this-to-a-long-random-string

# Optional: forward contact form submissions to a webhook (e.g. Slack, Zapier, Formspree)
CONTACT_WEBHOOK_URL=

# Used in metadata, sitemap.xml and robots.txt — set to the real deployed domain
NEXT_PUBLIC_SITE_URL=https://ieeebabcock.org

# Supabase — create a project at https://supabase.com
# Use the service role key (not the anon key) for server-side writes
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Resend — create an account at https://resend.com and verify your domain
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@ieeebabcock.org

# Paystack — your existing Day 3 payment link for AXIS Congress
NEXT_PUBLIC_PAYSTACK_DAY3_URL=https://paystack.com/pay/your-link-here
